# Copy to .env and fill in. Never commit the real .env file.
# Every variable is validated at startup by src/lib/env.ts.

APP_ENV=development                  # development | preview | production
APP_URL=http://localhost:3000

# PostgreSQL. In production use the Neon pooled URL here and the direct URL below.
DATABASE_URL=postgresql://campusconnect:campusconnect@localhost:5432/campusconnect
DATABASE_URL_UNPOOLED=postgresql://campusconnect:campusconnect@localhost:5432/campusconnect

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
ALLOWED_EMAIL_DOMAINS=biit.edu.pk     # comma separated, empty allows any domain
REG_NO_PATTERN=^\d{4}-[A-Za-z]{2,6}-\d{3,5}$
REQUIRE_ADMIN_2FA=false              # true in production

# Object storage (S3 API). Local: MinIO from docker-compose.dev.yml. Production: Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=campusconnect-dev
S3_ACCESS_KEY_ID=campusconnect
S3_SECRET_ACCESS_KEY=campusconnect-secret
S3_FORCE_PATH_STYLE=true

# Rate limiting. Leave empty locally to use the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email. Resend in production; SMTP (Mailpit on :1025) locally. With neither, emails are logged.
EMAIL_FROM=CampusConnect <no-reply@campusconnect.local>
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it-support@biit.edu.pk

# Secrets for cron and deep health checks
CRON_SECRET=change-me-cron-secret
HEALTH_SECRET=change-me-health-secret

# Seed: password for the seeded admin accounts in non-production environments
SEED_ADMIN_PASSWORD="Campus#Connect2026"
